{
  "name": "hotel-management-system",
  "version": "1.0.0",
  "description": "Complete hotel management system with PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:up": "ts-node src/migrate.ts up",
    "migrate:down": "ts-node src/migrate.ts down",
    "migrate:create": "ts-node src/migrate.ts create",
    "migrate:status": "ts-node src/migrate.ts status",
    "seed": "ts-node src/database/seeds/seed.ts",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docker:build":   "docker compose build --no-cache",
    "docker:up":      "docker compose up -d",
    "docker:down":    "docker compose down",
    "docker:logs":    "docker compose logs -f app",
    "docker:restart": "docker compose restart app",
    "docker:shell":   "docker compose exec app sh",
    "docker:db":      "docker compose exec db psql -U bistro_user -d bistro_cafe"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "slugify": "^1.6.6",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
